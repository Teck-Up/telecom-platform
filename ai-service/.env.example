LOG_LEVEL=DEBUG
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# French + English OCR models live in ai-service/tessdata/ (run setup once)
# Download: fra.traineddata from github.com/tesseract-ocr/tessdata
# Copy eng.traineddata from Tesseract install tessdata folder

OPENAI_API_KEY=

# Google AI Studio — Text-to-SQL chatbot (free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Payment document scan: auto (Gemini then Tesseract) | gemini | tesseract
PAYMENT_OCR_ENGINE=auto

BACKEND_URL=http://localhost:5000

# MySQL (read-only analytics for /chat)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=telecom_platform
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=5
